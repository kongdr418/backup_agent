# 智创空间 - 多智能体智慧课堂平台 环境变量配置
# 复制此文件为 .env 并填入你的 API Keys

# MiniMax API (app.py 和 minimax_agent.py 使用，作为默认对话/调度大模型之一)
MINIMAX_API_KEY=your_minimax_api_key_here

# DeepSeek API (课程大纲/讲稿/习题集/测验/知识卡片/思维导图 生成器使用)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 科大讯飞星火 API (OpenAI 兼容接口；可填 APIpassword 或 AK:SK；X2/v2 权限以讯飞控制台为准)
XFYUN_API_KEY=your_xfyun_api_password_here

# MiMo API (语音合成)
MIMO_API_KEY=your_mimo_api_key_here

# MiniMax Image API (学习资源封面图生成)
MINIMAX_IMAGE_API_KEY=your_minimax_image_api_key_here
